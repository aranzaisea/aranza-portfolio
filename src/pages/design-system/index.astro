  var C=[['standard','cubic-bezier(.2,.7,.1,1)',[.2,.7,.1,1],'Cards, sections, covers'],['in-out','cubic-bezier(.65,0,.35,1)',[.65,0,.35,1],'Stage changes in the field'],['linear','linear',[0,0,1,1],'Progress and loaders only']];
  var cv=document.getElementById('curves');
  cv.innerHTML=C.map(function(c,i){var p=c[2];return'<div class="curve"><span class="lab">'+c[0]+'</span><svg viewBox="-4 -4 108 108" aria-hidden="true"><line x1="0" y1="100" x2="100" y2="100"/><line x1="0" y1="0" x2="0" y2="100"/><path d="M0 100 C'+p[0]*100+' '+(100-p[1]*100)+' '+p[2]*100+' '+(100-p[3]*100)+' 100 0"/></svg><code class="mono" style="font-size:11.5px;color:var(--ink-2)">'+c[1]+'</code><div class="track"><i id="dot'+i+'"></i></div><p>'+c[3]+'</p></div>'}).join('');
