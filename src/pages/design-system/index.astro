  (function(){var x=document.getElementById('st1').getContext('2d'),t=document.createElement('canvas');t.width=240;t.height=240;var g=t.getContext('2d');g.font='600 72px Geist, sans-serif';g.textAlign='center';g.fillText('ai',120,150);var d=g.getImageData(0,0,240,240).data,R=rnd(5),n=0;
