---
import { getCollection } from 'astro:content';
import { CASES } from '../../../data/cases';
import CasePage from '../../../components/case/CasePage.astro';
import StoryPage from '../../../components/story/StoryPage.astro';
import { STORIES } from '../../../story';
export async function getStaticPaths() {
  const all = await getCollection('cases', (e) => e.data.lang === 'en' && CASES.some((c) => c.slug === e.data.case));
  return all.map((entry) => ({ params: { slug: entry.data.case }, props: { entry } }));
}
const { entry } = Astro.props;
const story = STORIES[entry.data.case];
---
{story ? <StoryPage slug={entry.data.case} html={story} /> : <CasePage entry={entry} />}
