---
import { getCollection } from 'astro:content';
import CasePage from '../../components/case/CasePage.astro';
export async function getStaticPaths() {
  const all = await getCollection('cases', (e) => e.data.lang === 'en');
  return all.map((entry) => ({ params: { slug: entry.data.case }, props: { entry } }));
}
const { entry } = Astro.props;
---
<CasePage entry={entry} />
