---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="Page not found | Aranza Isea" description="This page doesn't exist." noindex noAlt>
  <section class="wrap" style="padding:120px 0 40px;max-width:760px">
    <p class="eyebrow">404</p>
    <h1 class="h-1" style="margin:18px 0">This page doesn’t exist.</h1>
    <p class="lead">It may have moved when the site was rebuilt. <span lang="es">Esta página no existe; puede que se haya movido.</span></p>
    <p style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap"><a class="btn btn--primary" href="/">Home</a><a class="btn btn--ghost" href="/es/">Inicio</a></p>
  </section>
</Base>
