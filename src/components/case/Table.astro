---
// Data table that turns into labelled cards on narrow screens, so it never scrolls sideways.
interface Props { head: string[]; rows: string[][]; caption?: string; first?: boolean; d?: 'standard' | 'deep' }
const { head, rows, caption, first = true, d } = Astro.props;
---
<figure class="tb" data-d={d}>
  <table class:list={[{ 'tb--first': first }]}>
    <thead><tr>{head.map((h) => <th scope="col">{h}</th>)}</tr></thead>
    <tbody>
      {rows.map((r) => (
        <tr>{r.map((c, i) => (i === 0 && first ? <th scope="row" data-l={head[i]} set:html={c} /> : <td data-l={head[i]} set:html={c} />))}</tr>
      ))}
    </tbody>
  </table>
  {caption && <figcaption class="tb__cap">{caption}</figcaption>}
</figure>
<style>
  .tb{margin:0;min-width:0}
  table{width:100%;border-collapse:separate;border-spacing:0;border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--panel-2);font-size:15px}
  thead th{text-align:left;font:500 11.5px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-faint);padding:14px 16px;border-bottom:1px solid var(--line);background:var(--bg-deep)}
  tbody th,tbody td{text-align:left;vertical-align:top;padding:14px 16px;border-bottom:1px solid var(--line-soft);color:var(--ink-2);line-height:1.5}
  tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}
  tbody th{color:var(--ink);font-weight:600}
  td :global(strong){color:var(--ink);font-weight:600}
  td :global(.sev){display:inline-block;font:500 11px var(--mono);letter-spacing:.06em;text-transform:uppercase;padding:2px 7px;border-radius:5px;border:1px solid var(--line-strong);white-space:nowrap}
  td :global(.sev--3){color:#F2A99B;border-color:#6a3329} td :global(.sev--2){color:var(--human);border-color:#5a4826} td :global(.sev--ok){color:var(--live);border-color:#2f5a3e}
  .tb__cap{margin:14px 0 0;font-size:14px;color:var(--ink-faint)}
  @media (max-width:760px){
    table,thead,tbody,tr,th,td{display:block}
    table{border:0;background:none;border-radius:0}
    thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
    tbody{display:flex;flex-direction:column;gap:12px}
    tbody tr{border:1px solid var(--line);border-radius:12px;background:var(--panel-2);padding:6px 0}
    tbody th,tbody td{border:0;padding:8px 16px}
    tbody td::before{content:attr(data-l);display:block;font:500 11px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--ink-faint);margin-bottom:2px}
  }
</style>
