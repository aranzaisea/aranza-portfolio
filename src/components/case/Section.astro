---
interface Props { n?: string; id?: string; label?: string; title: string; d?: 'standard' | 'deep'; tag?: string }
const { n, id, label, title, d, tag } = Astro.props;
---
<section class="cs-sec" id={id} data-d={d}>
  <div class="wrap">
    <header class="cs-sec__head">
      <p class="label">{n && <span class="cs-sec__n">{n}</span>}{label}{tag && <span class="badge badge--neutral cs-sec__tag">{tag}</span>}</p>
      <h2 class="h-2">{title}</h2>
    </header>
    <div class="cs-sec__body"><slot /></div>
  </div>
</section>
<style>
  /* Spacing system for case sections (8-pt based):
     section → section 120 · title → content 40 · text → text 24
     anything → visual 64 · visual → visual 96 · visual → text 64 */
  .cs-sec{padding:clamp(88px,9vw,128px) 0 0}
  .cs-sec__head{max-width:880px;margin-bottom:40px}
  .cs-sec__head .label{display:flex;align-items:center;gap:12px;margin:0 0 16px}
  .cs-sec__n{color:var(--ai);margin-right:2px}
  .cs-sec__tag{margin-left:4px}
  .cs-sec__body > :global(.prose){max-width:68ch}
  .cs-sec__body > :global(p){margin:0}
  .cs-sec__body > :global(*){margin-top:0;margin-bottom:0}
  /* default: text after text */
  .cs-sec__body > :global(:not(script):not(style) ~ :not(script):not(style)){margin-top:24px}
  /* any visual block after something */
  .cs-sec__body > :global(:not(script):not(style) ~ :is(figure,.g,.insights,.decs,.mets,.steps,.note,.qt)){margin-top:64px}
  /* a screen after a screen */
  .cs-sec__body > :global(:is(figure,.g) + :is(figure,.g)),.cs-sec__body > :global(:is(figure,.g) + script + :is(figure,.g)){margin-top:clamp(72px,7vw,96px)}
  /* text after a screen */
  .cs-sec__body > :global(:is(figure,.g) + :is(.prose,p,.only)),.cs-sec__body > :global(:is(figure,.g) + script + :is(.prose,p,.only)){margin-top:64px}
  /* text after numbers or cards */
  .cs-sec__body > :global(:is(.mets,.insights,.decs,.steps) + .prose){margin-top:40px}
  /* small caption lines that follow a block keep their own inline spacing */
  .cs-sec__body > :global(p.dim){margin-top:16px}
</style>
