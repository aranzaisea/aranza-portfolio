---
interface Props { items: { v: string; l: string; note?: string }[]; d?: 'standard' | 'deep' }
const { items, d } = Astro.props;
---
<dl class="mets" data-d={d}>
  {items.map((m) => <div><dt>{m.v}</dt><dd>{m.l}{m.note && <small>{m.note}</small>}</dd></div>)}
</dl>
<style>
  .mets{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin:0}
  .mets div{border:1px solid var(--line);border-radius:var(--r);padding:20px 22px;background:var(--panel-2)}
  .mets dt{font-size:clamp(34px,3.6vw,46px);font-weight:600;letter-spacing:-.03em;color:var(--live);line-height:1.05}
  .mets dd{margin:8px 0 0;color:var(--ink-2)}
  .mets small{display:block;margin-top:6px;color:var(--ink-faint);font:12.5px/1.45 var(--mono)}
</style>
