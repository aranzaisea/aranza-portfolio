---
interface Props { items: [string, string][]; d?: 'standard' | 'deep' }
const { items, d } = Astro.props;
---
<ol class="steps" data-d={d}>
  {items.map(([t, b], i) => <li><span class="steps__n">{String(i + 1).padStart(2, '0')}</span><strong>{t}</strong><span>{b}</span></li>)}
</ol>
<style>
  .steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:var(--r);overflow:hidden}
  .steps li{background:var(--panel-2);padding:20px;display:flex;flex-direction:column;gap:6px;font-size:15.5px;color:var(--ink-2)}
  .steps strong{color:var(--ink);font-weight:600;font-size:16.5px}
  .steps__n{font:500 12.5px var(--mono);color:var(--ai)}
</style>
