---
import Base from '../../layouts/Base.astro';
import Img from '../Img.astro';
import { CASES } from '../../data/cases';
import { CV, EMAIL, LINKEDIN, SITE, caseUrl, patternsUrl, type Lang } from '../../i18n/ui';
import engine from './particles.js?raw';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';

const c = en ? {
  title: 'Aranza Isea — Senior Product Designer · Product, UX/UI & AI',
  desc: 'Senior Product Designer and UX/UI Designer with 10+ years in product design, user research and design systems: B2B e-commerce, loyalty and mobile apps, enterprise SaaS and AI products such as copilots and agents. Based in Buenos Aires, working remotely.',
  role: 'Senior Product Designer · Product · UX/UI · AI · Buenos Aires',
  thesis: ['I design clear products for ', 'complex work', ', ', 'with or without AI.'],
  lead: '10+ years across product, UX/UI and research: B2B e-commerce, loyalty apps, design systems, enterprise SaaS and, lately, AI copilots and agents for insurance and compliance. I take products from research to handoff, and when there’s AI inside, I design its behaviour as carefully as the screens.',
  ctaWork: 'See the work', ctaCv: 'Download resume',
  switchLabel: 'Ver en español', switchHref: '/es/', switchLang: 'es',
  reduced: 'Your device asks for reduced motion, so the background starts still.',
  sigEyebrow: 'Signal', sigH: 'Results, each with its source.',
  sigLead: 'Every number below comes with who measured it and over what period. If a case has no metrics yet, it says so.',
  statsAlso: 'Also experienced in design systems, loyalty and mobile apps, B2B e-commerce and enterprise SaaS.',
  skEyebrow: 'Skills', skH: 'What I bring to a product team.',
  skills: [
    ['Product & UX/UI design', ['Product design', 'UX/UI design', 'UI design', 'Visual design', 'Interaction design', 'Information architecture', 'User flows', 'Wireframing', 'Prototyping', 'Design systems', 'Responsive design', 'Mobile design (iOS, Android)', 'Accessibility (WCAG)', 'Developer handoff']],
    ['Research & strategy', ['User research', 'User interviews', 'Usability testing', 'A/B testing', 'Heuristic evaluation', 'Journey mapping', 'Service blueprints', 'Personas', 'Competitive analysis', 'Stakeholder workshops', 'Design thinking']],
    ['AI products', ['Generative AI', 'AI copilots', 'AI agents', 'Multi-agent workflows', 'Human-in-the-loop design', 'Confidence & explainability', 'AI failure states', 'Audit trails', 'Prompt engineering']],
    ['Ways of working', ['Agile & Scrum', 'Cross-functional teams', 'Stakeholder alignment', 'End-to-end ownership', 'Remote collaboration', 'Spanish (native)', 'English (C1)']],
    ['Tools', ['Figma', 'Figma Make', 'FigJam', 'Miro', 'Jira', 'Adobe Photoshop', 'Adobe Illustrator', 'Hotjar', 'Notion', 'Claude', 'Claude Code', 'ChatGPT', 'Cursor', 'n8n']],
    ['Industries', ['B2B e-commerce', 'Enterprise SaaS', 'Loyalty & mobile apps', 'Fashion e-commerce', 'Insurance', 'Fintech & compliance']],
  ],
  stats: [['10+', 'years in product, UX, UI and research', '2015 → 2026'], ['~500', 'adjusters using the ClaimPro copilot', '90%+ adoption · 2 months'], ['−68%', 'claim resolution time with ClaimPro', 'client-reported · 3 months'], ['+65%', 'Business accounts after Off Dep launched', 'Off Dep Business']],
  workEyebrow: 'Selected work · 6 cases', workH: 'Some things I’ve designed.',
  workLead: 'From a loyalty app and B2B e-commerce to AI copilots. Every case opens with a 30-second summary; use the reading dial inside to go deeper.',
  read: 'Read →', concept: 'Independent concept',
  apEyebrow: 'Approach · the person stays at the centre', apH: 'How I work.', apIntro: 'These come from years of product work and from designing AI systems, and they apply to any product where trust and clarity matter.',
  principles: [
    ['A diagnostic before a playbook', 'Every project starts with the goal, the scope and what we already know. The research methods and the process follow from that, not from a template.'],
    ['Design the failure first', 'Empty states, errors, data that doesn’t match, a system that’s down. If the unhappy path isn’t designed, people stop trusting the happy one.'],
    ['With AI, autonomy is a setting', 'The AI drafts and a person approves by default. Teams earn more autonomy per task, with thresholds an admin can see, simulate and undo.'],
  ],
  patternsCta: '→ See the AI patterns behind these cases',
  exEyebrow: 'Experience log', exH: '10+ years designing products, from design systems to AI.',
  jobs: [
    ['2026 – now', 'Independent product work', 'Independent', 'Designed Numi, an independent iOS product, earned AI certifications from IBM and Coderhouse, and rebuilt this portfolio. Available immediately.'],
    ['2024 – 2026', 'Senior Product Designer · AI products', 'Perficient', 'Owned ClaimPro end to end and designed Vantage, a multi-agent compliance platform.'],
    ['2022 – 2024', 'Senior UX/UI Designer', 'Perficient', 'Off Dep Business (B2B e-commerce with AI), Club Rumbo (loyalty app MVP for iOS and Android), enterprise SaaS and admin systems.'],
    ['2019 – 2022', 'Senior Visual Designer', 'Perficient', 'Led visual design and built the Advanced Design System: visual standards, UI components and documentation adopted across product teams.'],
    ['2017 – 2019', 'Product Designer', 'Distrito Moda', 'Multi-sided fashion e-commerce for retail and wholesale buyers, from research to handoff.'],
    ['2015 – 2017', 'Junior UX/UI Designer', 'Tsserapp', 'Moved from graphic design into UX/UI design: user flows, interface design and usability.'],
  ],
  edu: 'Diploma in Product Design, Coderhouse · Specialization in User Experience and Bachelor’s in Graphic Design, Universidad Rafael Belloso Chacín · AI certifications from IBM and Coderhouse',
  ctEyebrow: 'Open to senior roles · remote or hybrid from Buenos Aires (GMT-3)',
  ctH: 'Hiring for a product or AI product team?', available: 'Available now', copy: 'copy', copied: 'copied', selected: 'selected',
  portraitAlt: 'Portrait of Aranza Isea',
  labels: { names: ['name', 'signal', 'structure', 'brain'], cre: 'creativity', rea: 'reasoning', noise: 'noise', play: 'play motion', pause: 'pause motion', playAnim: '▶  Play animation', replay: '↻  Replay' },
  signal: 'signal', field: 'Particle field',
} : {
  title: 'Aranza Isea — Product Designer Senior · Producto, UX/UI e IA',
  desc: 'Product Designer Senior y diseñadora UX/UI con más de 10 años en diseño de producto, investigación de usuarios y design systems: e-commerce B2B, apps de fidelización y móviles, SaaS empresarial y productos con IA como copilotos y agentes. Desde Buenos Aires, trabajo remoto.',
  role: 'Product Designer Senior · Producto · UX/UI · IA · Buenos Aires',
  thesis: ['Diseño productos claros para ', 'trabajos complejos', ', ', 'con o sin IA.'],
  lead: 'Más de 10 años en producto, UX/UI e investigación: e-commerce B2B, apps de fidelización, design systems, SaaS empresarial y, en los últimos años, copilotos y agentes de IA para seguros y compliance. Llevo productos del research al handoff, y cuando hay IA adentro, diseño su comportamiento con el mismo cuidado que las pantallas.',
  ctaWork: 'Ver proyectos', ctaCv: 'Descargar CV',
  switchLabel: 'Read in English', switchHref: '/', switchLang: 'en',
  reduced: 'Tu dispositivo pide reducir el movimiento, así que el fondo empieza quieto.',
  sigEyebrow: 'Señal', sigH: 'Resultados, cada uno con su fuente.',
  sigLead: 'Cada número indica quién lo midió y en qué período. Si un caso todavía no tiene métricas, lo dice.',
  statsAlso: 'También con experiencia en design systems, apps de fidelización y móviles, e-commerce B2B y SaaS empresarial.',
  skEyebrow: 'Habilidades', skH: 'Lo que sumo a un equipo de producto.',
  skills: [
    ['Diseño de producto y UX/UI', ['Diseño de producto', 'Diseño UX/UI', 'Diseño de UI', 'Diseño visual', 'Diseño de interacción', 'Arquitectura de información', 'User flows', 'Wireframes', 'Prototipado', 'Design systems', 'Diseño responsive', 'Diseño mobile (iOS, Android)', 'Accesibilidad (WCAG)', 'Handoff a desarrollo']],
    ['Investigación y estrategia', ['Investigación de usuarios', 'Entrevistas', 'Testing de usabilidad', 'A/B testing', 'Evaluación heurística', 'Journey map', 'Service blueprint', 'Personas', 'Análisis competitivo', 'Talleres con stakeholders', 'Design thinking']],
    ['Productos con IA', ['IA generativa', 'Copilotos de IA', 'Agentes de IA', 'Flujos multiagente', 'Diseño human-in-the-loop', 'Confianza y explicabilidad', 'Estados de falla de la IA', 'Registros de auditoría', 'Prompt engineering']],
    ['Forma de trabajo', ['Agile y Scrum', 'Equipos multidisciplinarios', 'Alineación con stakeholders', 'Responsabilidad de punta a punta', 'Trabajo remoto', 'Español (nativo)', 'Inglés (C1)']],
    ['Herramientas', ['Figma', 'Figma Make', 'FigJam', 'Miro', 'Jira', 'Adobe Photoshop', 'Adobe Illustrator', 'Hotjar', 'Notion', 'Claude', 'Claude Code', 'ChatGPT', 'Cursor', 'n8n']],
    ['Industrias', ['E-commerce B2B', 'SaaS empresarial', 'Apps de fidelización y móviles', 'E-commerce de moda', 'Seguros', 'Fintech y compliance']],
  ],
  stats: [['10+', 'años en producto, UX, UI e investigación', '2015 → 2026'], ['~500', 'ajustadores usan el copiloto de ClaimPro', '90%+ de adopción · 2 meses'], ['−68%', 'tiempo de resolución de siniestros con ClaimPro', 'dato del cliente · 3 meses'], ['+65%', 'cuentas Business tras el lanzamiento de Off Dep', 'Off Dep Business']],
  workEyebrow: 'Proyectos · 6 casos', workH: 'Algunas cosas que diseñé.',
  workLead: 'De una app de fidelización y e-commerce B2B a copilotos de IA. Cada caso abre con un resumen de 30 segundos; con el dial de lectura podés profundizar.',
  read: 'Ver →', concept: 'Concepto independiente',
  apEyebrow: 'Enfoque · la persona queda en el centro', apH: 'Cómo trabajo.', apIntro: 'Salen de años de trabajo en producto y de diseñar sistemas con IA, y aplican a cualquier producto donde la confianza y la claridad importan.',
  principles: [
    ['Un diagnóstico antes que una receta', 'Cada proyecto arranca por el objetivo, el alcance y lo que ya sabemos. Los métodos de investigación y el proceso salen de ahí, no de una plantilla.'],
    ['Primero se diseña la falla', 'Estados vacíos, errores, datos que no coinciden, un sistema caído. Si el camino infeliz no está diseñado, la gente deja de confiar en el feliz.'],
    ['Con IA, la autonomía es un ajuste', 'Por defecto la IA prepara y una persona aprueba. Cada equipo gana más autonomía por tarea, con umbrales que un admin puede ver, simular y deshacer.'],
  ],
  patternsCta: '→ Ver los patrones de IA detrás de estos casos',
  exEyebrow: 'Trayectoria', exH: 'Más de 10 años diseñando productos, de design systems a IA.',
  jobs: [
    ['2026 – hoy', 'Trabajo de producto independiente', 'Independiente', 'Diseñé Numi, un producto independiente para iOS, obtuve certificaciones de IA de IBM y Coderhouse y rehice este portafolio. Disponible de inmediato.'],
    ['2024 – 2026', 'Senior Product Designer · Productos con IA', 'Perficient', 'Dueña de ClaimPro de punta a punta y diseño de Vantage, una plataforma de compliance multiagente.'],
    ['2022 – 2024', 'Senior UX/UI Designer', 'Perficient', 'Off Dep Business (e-commerce B2B con IA), Club Rumbo (MVP de app de fidelización para iOS y Android), SaaS empresarial y sistemas de administración.'],
    ['2019 – 2022', 'Senior Visual Designer', 'Perficient', 'Lideré el diseño visual y construí el Advanced Design System: estándares visuales, componentes de UI y documentación adoptados por varios equipos de producto.'],
    ['2017 – 2019', 'Product Designer', 'Distrito Moda', 'E-commerce de moda multilado para compradores minoristas y mayoristas, del research al handoff.'],
    ['2015 – 2017', 'Junior UX/UI Designer', 'Tsserapp', 'Pasé del diseño gráfico al diseño UX/UI: flujos de usuario, diseño de interfaces y usabilidad.'],
  ],
  edu: 'Diplomatura en Product Design, Coderhouse · Especialización en Experiencia de Usuario y Licenciatura en Diseño Gráfico, Universidad Rafael Belloso Chacín · Certificaciones de IA de IBM y Coderhouse',
  ctEyebrow: 'Abierta a roles senior · remoto o híbrido desde Buenos Aires (GMT-3)',
  ctH: '¿Buscás diseño para un equipo de producto o de producto con IA?', available: 'Disponible ya', copy: 'copiar', copied: 'copiado', selected: 'seleccionado',
  portraitAlt: 'Retrato de Aranza Isea',
  labels: { names: ['nombre', 'señal', 'estructura', 'cerebro'], cre: 'creatividad', rea: 'razonamiento', noise: 'ruido', play: 'reanudar', pause: 'pausar movimiento', playAnim: '▶  Reproducir animación', replay: '↻  Repetir' },
  signal: 'señal', field: 'Campo de partículas',
};

const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Person', name: 'Aranza Isea', jobTitle: 'Senior Product Designer', url: SITE + '/',
  email: `mailto:${EMAIL}`, sameAs: [LINKEDIN], address: { '@type': 'PostalAddress', addressLocality: 'Buenos Aires', addressCountry: 'AR' },
  description: c.desc,
  knowsAbout: ['Product design', 'UX/UI design', 'UI design', 'Visual design', 'Interaction design', 'Information architecture', 'User research', 'Usability testing', 'A/B testing', 'Design systems', 'Prototyping', 'Accessibility (WCAG)', 'Agile and Scrum', 'Figma', 'B2B e-commerce', 'Enterprise SaaS', 'Mobile apps', 'AI product design', 'Generative AI', 'AI agents', 'AI copilots', 'Human-in-the-loop design', 'Insurance', 'Fintech'],
  knowsLanguage: ['es', 'en'],
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Universidad Rafael Belloso Chacín' }, { '@type': 'EducationalOrganization', name: 'Coderhouse' }],
  hasOccupation: { '@type': 'Occupation', name: 'Senior Product Designer', occupationLocation: { '@type': 'City', name: 'Buenos Aires' },
    skills: 'Product design, UX/UI design, user research, usability testing, interaction design, prototyping, design systems, accessibility, AI product design, Figma' },
  subjectOf: { '@type': 'DigitalDocument', name: en ? 'Resume' : 'CV', encodingFormat: 'application/pdf', url: SITE + CV[lang] },
};
---
<Base lang={lang} title={c.title} description={c.desc} jsonLd={jsonLd} variant="home">
  <canvas id="field" aria-hidden="true" data-labels={JSON.stringify(c.labels)}></canvas>
  <div class="scrim" aria-hidden="true"></div>
  <span class="lobe lobe--cre" id="lobeCre" aria-hidden="true"></span>
  <span class="lobe lobe--rea" id="lobeRea" aria-hidden="true"></span>

  <div class="lp">
    <section class="hero wrap" data-stage="0">
      <div class="idblock">
        <h1 class="name">Aranza Isea</h1>
        <p class="role mono">{c.role}</p>
      </div>
      <div class="hero__text">
        <p class="thesis">{c.thesis[0]}<span class="t-ai">{c.thesis[1]}</span>{c.thesis[2]}<span class="t-hu">{c.thesis[3]}</span></p>
        <p class="lead">{c.lead}</p>
        <div class="cta">
          <a class="btn btn--primary" href="#work">{c.ctaWork}</a>
          <a class="btn btn--ghost" href={CV[lang]} download>{c.ctaCv} ↓</a>
          <button type="button" class="btn play" id="heroPlay" aria-pressed="false">{c.labels.replay}</button>
          <a class="btn btn--ghost lang-cta" href={c.switchHref} hreflang={c.switchLang} lang={c.switchLang}>
            <span class:list={['seg', { on: !en }]} aria-hidden="true">EN</span><span class:list={['seg', { on: en }]} aria-hidden="true">ES</span>{c.switchLabel}
          </a>
        </div>
        <p class="note mono" id="heroNote" hidden>{c.reduced}</p>
      </div>
    </section>

    <section class="sec wrap" data-stage="1" aria-labelledby="signal-h">
      <p class="eyebrow">{c.sigEyebrow}</p>
      <h2 id="signal-h" class="h2">{c.sigH}</h2>
      <p class="lead sub">{c.sigLead}</p>
      <div class="metrics">
        {c.stats.map(([v, l, s]) => <div class="metric"><span class="n">{v}</span><span class="d">{l}</span><span class="s mono">{s}</span></div>)}
      </div>
      <p class="also">{c.statsAlso}</p>
    </section>

    <section class="sec wrap" id="work" data-stage="2" aria-labelledby="work-h">
      <div class="head-row">
        <div>
          <p class="eyebrow">{c.workEyebrow}</p>
          <h2 id="work-h" class="h2">{c.workH}</h2>
        </div>
        <p>{c.workLead}</p>
      </div>
      <ul class="cases">
        {CASES.map((x) => (
          <li class="case">
            <div class="bar mono">
              <span class="id">case_{x.no}</span>
              {x.ai && <span class="ai-chip">AI</span>}
              <span class:list={['st', x.status === 'concept' ? 'c' : 'l']}><i class:list={['dot', x.status === 'concept' ? 'a' : 'l']}></i>{x.statusLabel[lang]}</span>
            </div>
            <div class="shot"><Img src={`cards/${x.slug}.jpg`} alt={x.coverAlt[lang]} widths={[640, 960, 1200]} sizes="(min-width: 1100px) 420px, (min-width: 640px) 46vw, 92vw" /></div>
            <div class="body">
              <span class="dom mono">{x.tag[lang]}</span>
              <h3>{x.name}</h3>
              <p class="line">{x.sentence[lang]}</p>
              <ul class="kpis">{x.chips[lang].map((ch) => <li class="mono">{ch}</li>)}</ul>
              <div class="foot"><span>{x.role[lang]}{x.where[lang] && ` · ${x.where[lang].replace(/^(at|en) /, '')}`}{x.year && ` · ${x.year}`}</span><a class="more" href={caseUrl(lang, x.slug)}>{c.read}<span class="sr-only"> {x.name}</span></a></div>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="sec wrap" id="approach" data-stage="3" aria-labelledby="approach-h">
      <p class="eyebrow">{c.apEyebrow}</p>
      <h2 id="approach-h" class="h2">{c.apH}</h2>
      <p class="lead sub">{c.apIntro}</p>
      <ol class="rules">
        {c.principles.map(([h, b], i) => <li class="rule"><span class="k mono">rule_0{i + 1}</span><div><h3>{h}</h3><p>{b}</p></div></li>)}
      </ol>
      <a class="patterns mono" href={patternsUrl(lang)}>{c.patternsCta}</a>
    </section>

    <section class="sec wrap" id="experience" data-stage="3" aria-labelledby="exp-h">
      <p class="eyebrow">{c.exEyebrow}</p>
      <h2 id="exp-h" class="h2">{c.exH}</h2>
      <ol class="log">
        {c.jobs.map(([y, r, co, d], i) => <li class:list={['row', { now: i === 0 }]}><span class="yr mono">{y}</span><div><p class="r">{r} <span>· {co}</span></p><p>{d}</p></div></li>)}
      </ol>
      <p class="edu">{c.edu}</p>
    </section>

    <section class="sec wrap" id="skills" data-stage="3" aria-labelledby="skills-h">
      <p class="eyebrow">{c.skEyebrow}</p>
      <h2 id="skills-h" class="h2">{c.skH}</h2>
      <div class="skills">
        {c.skills.map(([h, items]) => (
          <section class="sk">
            <h3 class="mono">{h}</h3>
            <ul>{items.map((i) => <li>{i}</li>)}</ul>
          </section>
        ))}
      </div>
    </section>

    <section class="sec wrap contact" id="contact" data-stage="3" aria-labelledby="contact-h">
      <figure class="portrait">
        <Img src="site/hero-portrait.webp" alt={c.portraitAlt} widths={[398]} sizes="260px" ratio="398/524" />
        <figcaption class="mono"><span class="avail"><i class="dot l"></i>{c.available}</span><span>GMT-3</span></figcaption>
      </figure>
      <div>
        <p class="eyebrow">{c.ctEyebrow}</p>
        <h2 id="contact-h" class="h2">{c.ctH}</h2>
        <div class="cmd mono"><span class="p" aria-hidden="true">&gt;</span><span class="em" id="email">{EMAIL}</span><button type="button" id="copy" data-copied={c.copied} data-selected={c.selected}>{c.copy}</button></div>
        <div class="cta">
          <a class="btn btn--primary" href={LINKEDIN} target="_blank" rel="me noopener">LinkedIn ↗</a>
          <a class="btn btn--ghost" href={CV[lang]} download>{c.ctaCv} ↓</a>
        </div>
      </div>
    </section>
  </div>

  <div class="hud" aria-label={c.field}>
    <div class="read" aria-hidden="true"><span class="stage" id="hudStage">{c.labels.names[0]}</span><span class="meter"><i id="hudBar"></i></span><span class="val">{c.signal} <span id="hudVal">0.00</span></span></div>
    <button type="button" id="pause" aria-pressed="false">{c.labels.pause}</button>
  </div>
</Base>

<script is:inline>
  (function(){
    var copy=document.getElementById('copy');if(!copy)return;var base=copy.textContent;
    copy.addEventListener('click',function(){
      var el=document.getElementById('email');
      function sel(){var r=document.createRange();r.selectNodeContents(el);var s=getSelection();s.removeAllRanges();s.addRange(r);copy.textContent=copy.dataset.selected}
      try{navigator.clipboard.writeText(el.textContent).then(function(){copy.textContent=copy.dataset.copied;setTimeout(function(){copy.textContent=base},1600)},sel)}catch(e){sel()}
    });
  })();
</script>
<script is:inline set:html={`(function(){${engine}})();`}></script>

<style is:global>
  /* Home only: particle field behind the page, content above it */
  .v-home{--panel-glass:rgba(255,255,255,.84);--scrim-a:rgba(244,245,248,.45);--scrim-b:rgba(244,245,248,.2);--scrim-c:rgba(244,245,248,0)}
  .v-home .lp,.v-home .site-footer{position:relative;z-index:2}
  .v-home .site-footer{margin-top:0;background:rgba(244,245,248,.8)}
  #field{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;display:block}
  .no-gl #field,.no-gl .hud,.no-gl #heroPlay{display:none}
  .no-gl .v-home{background:radial-gradient(60% 50% at 75% 40%,rgba(71,87,207,.16),transparent 70%),radial-gradient(20% 20% at 72% 45%,rgba(214,140,30,.16),transparent 70%),var(--bg) fixed}
  .scrim{position:fixed;inset:0;z-index:1;pointer-events:none;background:linear-gradient(90deg,var(--scrim-a) 0%,var(--scrim-b) 38%,var(--scrim-c) 62%)}
  @media (max-width:820px){.scrim{background:linear-gradient(180deg,var(--scrim-b),var(--scrim-a))}}

  .lp .h2{font-size:clamp(30px,4vw,52px);line-height:1.06;letter-spacing:-.04em;font-weight:600;max-width:18ch;margin:18px 0 0;text-wrap:balance}
  .lp .lead{font-size:clamp(17px,1.5vw,19px);color:var(--ink-soft);max-width:56ch}
  .lp .sub{margin-top:24px}
  .lp .sec{padding-top:clamp(96px,16vh,180px);padding-bottom:0}
  .lp .dot{display:inline-block;width:7px;height:7px;border-radius:50%;margin-right:6px;vertical-align:1px}
  .lp .dot.a{background:var(--ai)} .lp .dot.l{background:var(--live)}

  /* hero */
  .lp .hero{min-height:calc(100svh - var(--header-h));display:grid;align-content:center;gap:40px;padding-top:72px;padding-bottom:96px}
  .lp .idblock{padding-bottom:8px;border-bottom:1px solid var(--line)}
  .lp .name{font-size:clamp(52px,14.5vw,156px);line-height:.92;letter-spacing:-.055em;font-weight:600;margin:0;white-space:nowrap}
  .gl-name .lp .name{color:transparent}
  .gl-name .lp .name::selection{color:var(--ink);background:var(--ai-bg)}
  .lp .role{font-size:12.5px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);display:flex;align-items:center;gap:10px;margin:22px 0 28px}
  .lp .role::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--ai);flex:none}
  .lp .thesis{font-size:clamp(26px,2.9vw,40px);line-height:1.12;letter-spacing:-.035em;font-weight:600;max-width:20ch;margin:0;text-wrap:balance}
  .lp .t-ai{color:var(--ai)} .lp .t-hu{color:var(--human)}
